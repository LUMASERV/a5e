{
  "name": "a5e",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "crds:generate": "bun run --filter '@a5e/schemas' generate",
    "crds:apply": "kubectl apply -k crds/",
    "dev:operator": "bun run --filter '@a5e/operator' dev",
    "dev:api": "bun run --filter '@a5e/api' dev",
    "dev:ui": "bun run --filter '@a5e/ui' dev",
    "docs:dev": "bun run --filter '@a5e/docs' dev",
    "docs:build": "bun run --filter '@a5e/docs' build",
    "seed": "bun run scripts/seed-fixtures.ts"
  },
  "dependencies": {
    "@a5e/schemas": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.7.3"
  }
}
